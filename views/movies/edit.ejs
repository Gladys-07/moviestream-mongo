<link rel="stylesheet" href="/styles.css">

<header>
  <h1>Editar película</h1>
  <p>Actualiza la información de la película seleccionada</p>

  <nav>
    <a href="/movies">Películas</a>
    <a href="/genres">Géneros</a>
    <a href="/movies/new">Nueva película</a>
  </nav>
</header>

<main class="container">
  <section class="form-wrapper">
    <div class="form-card-modern">

      <div class="movie-preview">
        <div class="movie-icon">🎬</div>

        <div>
          <h2><%= movie.title %></h2>
          <p>Edita la información y guarda los cambios.</p>
        </div>
      </div>

      <form method="POST" action="/movies/<%= movie._id %>?_method=PUT">

        <div class="form-grid">

          <div class="input-group">
            <label>Título</label>
            <input
              type="text"
              name="title"
              value="<%= movie.title %>"
              required
            >
          </div>

          <div class="input-group">
            <label>Año</label>
            <input
              type="number"
              name="year"
              value="<%= movie.year %>"
            >
          </div>

          <div class="input-group">
            <label>Duración (min)</label>
            <input
              type="number"
              name="duration"
              value="<%= movie.duration %>"
            >
          </div>

          <div class="input-group">
            <label>Precio</label>
            <input
              type="number"
              step="0.01"
              name="price"
              value="<%= movie.price %>"
            >
          </div>

          <div class="input-group">
            <label>Rating</label>
            <input
              type="number"
              step="0.1"
              name="rating"
              value="<%= movie.rating %>"
            >
          </div>

          <div class="input-group">
            <label>Actor</label>
            <input
              type="text"
              name="actorName"
              value="<%= movie.actors[0]?.name || '' %>"
            >
          </div>

          <div class="input-group">
            <label>Personaje</label>
            <input
              type="text"
              name="character"
              value="<%= movie.actors[0]?.character || '' %>"
            >
          </div>

        </div>

        <div class="input-group">
          <label>Géneros</label>

          <select name="genres" multiple class="genres-select">
            <% genres.forEach(genre => { %>
              <option
                value="<%= genre._id %>"
                <%= movie.genres.map(id => id.toString()).includes(genre._id.toString()) ? "selected" : "" %>
              >
                <%= genre.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-actions">
          <a href="/movies" class="btn btn-secondary">
            Cancelar
          </a>

          <button type="submit" class="btn">
            Guardar cambios
          </button>
        </div>

      </form>
    </div>
  </section>
</main>