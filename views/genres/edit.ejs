<link rel="stylesheet" href="/styles.css">

<header>
  <h1>Editar género</h1>
  <p>Actualiza la información de esta categoría</p>

  <nav>
    <a href="/movies">Películas</a>
    <a href="/genres">Géneros</a>
  </nav>
</header>

<main class="container">
  <section class="form-wrapper">
    <div class="form-card-modern">

      <div class="movie-preview">
        <div class="movie-icon">🏷️</div>

        <div>
          <h2><%= genre.name %></h2>
          <p>Edita el nombre o descripción del género.</p>
        </div>
      </div>

      <form method="POST" action="/genres/<%= genre._id %>?_method=PUT">
        <div class="input-group">
          <label>Nombre del género</label>
          <input 
            type="text" 
            name="name" 
            value="<%= genre.name %>" 
            required
          >
        </div>

        <div class="input-group">
          <label>Descripción</label>
          <textarea 
            name="description" 
            rows="5"
          ><%= genre.description %></textarea>
        </div>

        <div class="form-actions">
          <a href="/genres" class="btn btn-secondary">Cancelar</a>
          <button type="submit" class="btn">Guardar cambios</button>
        </div>
      </form>

    </div>
  </section>
</main>