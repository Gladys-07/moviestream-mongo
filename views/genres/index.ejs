<link rel="stylesheet" href="/styles.css">

<header>
  <h1>Géneros</h1>
  <p>Administra las categorías disponibles dentro de MovieStream</p>

  <nav>
    <a href="/movies">Películas</a>
    <a href="/genres">Géneros</a>
  </nav>
</header>

<main class="container">

  <div class="actions">
    <div></div>

    <a class="btn" href="/genres/new">
      + Nuevo género
    </a>
  </div>

  <% if (genres.length === 0) { %>

    <div class="empty-state">
      <h2>No hay géneros registrados</h2>
      <p>Agrega un nuevo género para comenzar.</p>
    </div>

  <% } %>

  <section class="grid">

    <% genres.forEach(genre => { %>

      <article class="card genre-card">

        <div class="genre-header">

          

          <div>
            <h2><%= genre.name %></h2>
          </div>

        </div>

        <p class="genre-description">
          <%= genre.description %>
        </p>

        <div class="card-actions">

          <a
            class="btn btn-secondary"
            href="/genres/<%= genre._id %>/edit"
          >
            Editar
          </a>

          <form
            method="POST"
            action="/genres/<%= genre._id %>?_method=DELETE"
          >
            <button type="submit">
              Eliminar
            </button>
          </form>

        </div>

      </article>

    <% }) %>

  </section>

</main>